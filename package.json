{
  "name": "dependency-upgrade-auditor",
  "version": "0.1.0",
  "private": true,
  "description": "Audit dependency upgrade revisions against a known baseline.",
  "type": "module",
  "bin": {
    "dependency-upgrade-auditor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "quality": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
